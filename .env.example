GOOGLE_PLACES_API_KEY=
# Mot de passe d'accès à l'outil une fois en ligne (fortement conseillé).
APP_PASSWORD=
# Murder party (/enquete-admin) : voix des personnages et SMS.
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Nom d'expéditeur des SMS (11 caractères max, sans accent ni espace)
TWILIO_FROM=LARMAND
